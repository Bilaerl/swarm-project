<robot name="my_robot">
    <!-- to specify colours -->
    <material name="orange">
        <color rgba="1 0.5 0 1"/>
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <!-- links -->
    <!-- base link is a dummy link to serve as the root of the robot -->
    <!-- this is because a root link should not have inertial properties-->
    <link name="base_link" />

    <link name="chassis">
        <visual>
            <geometry>
                <box size="1 0.5 0.1"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <box size="1 0.5 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="10"/>
            <inertia ixx="0.22" ixy="0" ixz="0" iyy="0.84" iyz="0" izz="1.04"/>
        </inertial>
    </link>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.3"/>
            </geometry>
            <origin rpy="-1.57075 0 0" xyz="0 -0.3 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.3"/>
            </geometry>
            <origin rpy="-1.57075 0 0" xyz="0 -0.3 0"/>
        </collision>
        <inertial>
            <mass value="4"/>
            <inertia ixx="0.09" ixy="0" ixz="0" iyy="0.09" iyz="0" izz="0.18"/> 
        </inertial>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.3"/>
            </geometry>
            <origin rpy="1.57075 0 0" xyz="0 0.3 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.3"/>
            </geometry>
            <origin rpy="1.57075 0 0" xyz="0 0.3 0"/>
        </collision>
        <inertial>
            <mass value="4"/>
            <inertia ixx="0.09" ixy="0" ixz="0" iyy="0.09" iyz="0" izz="0.18"/>
        </inertial>
    </link>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.125"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.125"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
        </collision>
    </link>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.2"/>
            </geometry>
            <material name="orange" />
        </visual>
    </link>
    
    <!-- joints -->
    <joint name="chassis_to_base_link" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
    </joint>

    <joint name="left_wheel_to_chassis" type="continuous">
        <parent link="chassis"/>
        <child link="left_wheel"/>
        <axis xyz="0 1 0"/>
        <origin rpy="0 0 0" xyz="-0.2 0 0"/>
    </joint>

    <joint name="right_wheel_to_chassis" type="continuous">
        <parent link="chassis"/>
        <child link="right_wheel"/>
        <axis xyz="0 1 0"/>
        <origin rpy="0 0 0" xyz="-0.2 0 0"/>
    </joint>

    <joint name="caster_wheel_to_chassis" type="continuous">
        <parent link="chassis"/>
        <child link="caster_wheel"/>
        <axis xyz="0 1 0"/>   
        <origin rpy="0 0 0" xyz="0.35 0 -0.175"/>
    </joint>

    <joint name="camera_to_chassis" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin rpy="0 0 0" xyz="0.4 0 0.1"/>
    </joint>

    <joint name="lidar_joint" type="fixed">
        <parent link="chassis"/>
        <child link="lidar_link"/>
        <origin rpy="0 0 0" xyz="0 0 0.1"/>        
    </joint>

    <gazebo>
        <!--diff drive plugin-->
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_to_chassis</left_joint>
            <right_joint>right_wheel_to_chassis</right_joint>
            <wheel_separation>0.6</wheel_separation>
            <wheel_radius>0.3</wheel_radius>
            <odom_publish_frequency>5</odom_publish_frequency>
            <topic>cmd_vel</topic>
            <odom_frame>odom</odom_frame>
            <child_frame_id>base_link</child_frame_id>
        </plugin>

        <!-- joint state publisher plugin -->
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_to_chassis</joint_name>
            <joint_name>right_wheel_to_chassis</joint_name>
            <joint_name>caster_wheel_to_chassis</joint_name>
        </plugin>
    </gazebo>

    <!-- camera plugin -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>camera/image_raw</topic>
            <gz_frame_id>camera_link</gz_frame_id>
            <frame_id>camera_link</frame_id>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
        <sensor name='gpu_lidar' type='gpu_lidar'>
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>640</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.396263</min_angle>
                        <max_angle>1.396263</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>0.01</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.08</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <always_on>1</always_on>
            <gz_frame_id>lidar_link</gz_frame_id>
            <frame_id>lidar_link</frame_id>
            <visualize>true</visualize>
        </sensor>
    </gazebo>
</robot>