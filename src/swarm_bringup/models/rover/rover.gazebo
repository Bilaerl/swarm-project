<?xml version="1.0"?>
<robot>
    <gazebo>
        <!--diff drive plugin-->
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <wheel_separation>${chassis_width + wheel_width/2}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <odom_publish_frequency>${odometry_update_rate}</odom_publish_frequency>
            <topic>$(arg robot_name)/cmd_vel</topic>
            <odom_topic>$(arg robot_name)/odom</odom_topic>
            <odom_frame>$(arg robot_name)/odom</odom_frame>
            <child_frame_id>$(arg robot_name)/base_link</child_frame_id>
        </plugin>

        <!-- joint state publisher plugin -->
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>$(arg robot_name)/joint_states</topic>
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>
        </plugin>

        <!-- imu sensor plugin -->
        <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

    <!-- camera sensor: based on raspberry pi camera module 3 -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>false</visualize>
            <gz_frame_id>$(arg robot_name)/camera_link_optical</gz_frame_id> <!-- added so gz publishes to link as expected by ros2-->
            <frame_id>$(arg robot_name)/camera_link_optical</frame_id>    <!-- a newer version of the above tag. For GZ Ionic upwards-->
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <topic>$(arg robot_name)/camera/image_raw</topic>
            <camera>
                <horizontal_fov>1.309</horizontal_fov> <!-- 75 degrees -->
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.01</near>
                    <far>15.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

    <!-- lidar sensor: based on RPLidar S1 -->
    <gazebo reference="lidar_link">
        <sensor name='gpu_lidar' type='gpu_lidar'>
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <gz_frame_id>$(arg robot_name)/lidar_link</gz_frame_id>
            <frame_id>$(arg robot_name)/lidar_link</frame_id>
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <topic>$(arg robot_name)/scan</topic>
            <ray>
                <scan>
                    <horizontal>
                        <samples>920</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>15.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
        </sensor>
    </gazebo>

    <!-- imu sensor -->
    <gazebo reference="chassis">
        <sensor name="imu_sensor" type="imu">
            <visualize>false</visualize>
            <gz_frame_id>$(arg robot_name)/chassis</gz_frame_id>
            <frame_id>$(arg robot_name)/chassis</frame_id>
            <always_on>1</always_on>
            <update_rate>${odometry_update_rate}</update_rate>
            <topic>$(arg robot_name)/imu</topic>
        </sensor>
    </gazebo>
</robot>